<?xml version="1.0" encoding="utf-8"?>
<!--
  Clariva-specific strings for the account landing screen.

  Kept OUT of localazy.xml on purpose: that file is generated by the Localazy
  sync and anything added there is lost on the next import. tools:ignore on
  MissingTranslation because these are not in the translation pipeline yet.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- Landing page tagline. Mirrors the clarivahub.com positioning: private,
         encrypted chats with paid expert consultants. -->
    <string name="clariva_welcome_tagline">Private conversations. Real value.\nEncrypted chats with trusted consultants.</string>

    <string name="clariva_auth_action_sign_in">Sign in</string>
    <string name="clariva_auth_action_create_account">Create account</string>
    <string name="clariva_auth_action_sign_in_google">Sign in with Google</string>
    <string name="clariva_auth_action_sign_up_google">Sign up with Google</string>
    <string name="clariva_auth_or">or</string>

    <string name="clariva_auth_name_label">Name</string>
    <string name="clariva_auth_name_placeholder">Your full name</string>
    <string name="clariva_auth_username_label">Username</string>
    <string name="clariva_auth_username_placeholder">e.g. jane.doe</string>
    <string name="clariva_auth_username_help">Your unique handle. This cannot be changed later.</string>
    <string name="clariva_auth_username_preview">You will be @%1$s:clarivahub.com</string>
    <string name="clariva_auth_username_checking">Checking availability…</string>
    <string name="clariva_auth_username_available">Available — you will be @%1$s:clarivahub.com</string>
    <string name="clariva_auth_email_label">Email</string>
    <string name="clariva_auth_email_placeholder">you@example.com</string>
    <!-- Sign-in accepts either; sign-up still asks for an email specifically. -->
    <string name="clariva_auth_identifier_label">Email or username</string>
    <string name="clariva_auth_identifier_placeholder">you@example.com or jane.doe</string>
    <string name="clariva_auth_password_label">Password</string>
    <string name="clariva_auth_password_hint">At least %1$d characters</string>
    <string name="clariva_auth_show_password">Show password</string>
    <string name="clariva_auth_hide_password">Hide password</string>

    <string name="clariva_auth_consultant_title">I am a consultant</string>
    <string name="clariva_auth_consultant_subtitle">Consultants are paid for chats.</string>

    <string name="clariva_auth_have_account">Already have an account? Sign in</string>
    <string name="clariva_auth_no_account">New to Clariva? Create an account</string>

    <string name="clariva_auth_google_not_configured">Google sign-in needs a server client ID to be configured.</string>

    <!-- Role choice for a Google user whose role is not yet known. Only shown
         when the account is being created, or when an existing row has no role
         recorded - a returning user with a role is never asked. -->
    <string name="clariva_google_role_title">Are you a consultant?</string>
    <string name="clariva_google_role_subtitle">Consultants are paid for the chats they take. This can be changed later in Settings.</string>
    <string name="clariva_google_role_subtitle_with_email">Setting up %1$s. Consultants are paid for the chats they take; this can be changed later in Settings.</string>
    <string name="clariva_google_role_no">No</string>
    <string name="clariva_google_role_no_hint">Chat with consultants and pay per conversation.</string>
    <string name="clariva_google_role_yes">Yes</string>
    <string name="clariva_google_role_yes_hint">Get paid for the chats you take.</string>
    <string name="clariva_google_role_confirm">Continue</string>

    <string name="clariva_auth_error_email_exists">An account with this email already exists. Please sign in instead.</string>

    <string name="clariva_auth_error_title">Sign-in failed</string>
    <string name="clariva_auth_error_generic">Something went wrong. Please try again.</string>

    <!-- Live email availability on the sign-up form (mirrors the username check). -->
    <string name="clariva_auth_email_checking">Checking availability…</string>
    <string name="clariva_auth_email_available">Email is available</string>
    <string name="clariva_auth_email_taken">That email is already registered. Sign in instead.</string>
    <string name="clariva_auth_email_invalid">Enter a valid email address</string>

    <!-- Forgot / reset password (6-digit code by email). -->
    <string name="clariva_auth_forgot_password">Forgot password?</string>
    <string name="clariva_forgot_title">Reset password</string>
    <string name="clariva_forgot_email_subtitle">Enter your account email and we\'ll send you a 6-digit reset code.</string>
    <string name="clariva_forgot_send_code">Send code</string>
    <string name="clariva_forgot_code_subtitle">If an account exists for %1$s, a 6-digit code is on its way. Enter it below with your new password.</string>
    <string name="clariva_forgot_code_label">6-digit code</string>
    <string name="clariva_forgot_new_password_label">New password</string>
    <string name="clariva_forgot_submit">Reset password</string>
    <string name="clariva_forgot_resend">Resend code</string>
    <string name="clariva_forgot_cancel">Cancel</string>
    <string name="clariva_forgot_success">Password reset. Sign in with your new password.</string>
</resources>
