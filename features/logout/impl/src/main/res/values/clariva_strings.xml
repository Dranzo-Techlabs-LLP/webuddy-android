<?xml version="1.0" encoding="utf-8"?>
<!--
  Clariva-specific sign-out copy. Kept OUT of localazy.xml on purpose: that file
  is regenerated by the Localazy sync and anything added there is lost on the
  next import.

  Clariva manages key storage server-side, so signing out never loses access to
  messages - they are restored automatically on the next sign-in. The upstream
  "have you saved your recovery key / you will lose access to your encrypted
  messages" warning is false here and alarms users for no reason.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="clariva_signout_title">Sign out?</string>
    <string name="clariva_signout_subtitle">Your chats are safely backed up. Sign in again on any device and they\'ll be waiting for you.</string>
</resources>
